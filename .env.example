# --- Database (Turso / libSQL) ---
# Local development uses a local SQLite file:
DATABASE_URL=file:cleanops.db
# Production (Vercel): use your Turso database URL, e.g. libsql://<db>-<org>.turso.io
# DATABASE_URL=libsql://your-db.turso.io
# Auth token is required for a remote Turso URL (leave empty for a local file):
DATABASE_AUTH_TOKEN=

# --- Auth ---
# Use a long random string in production (e.g. `openssl rand -base64 32`)
JWT_SECRET=change-me-to-a-long-random-secret-string

# --- Email (optional) ---
# Used for the "confirm your email" link on registration.
# Leave RESEND_API_KEY empty and confirmation links are printed to the server
# console instead of being emailed, so registration still works locally.
RESEND_API_KEY=
MAIL_FROM=CleanOps <onboarding@resend.dev>
# Base URL used to build links inside emails. Falls back to VERCEL_URL, then localhost.
APP_URL=http://localhost:3000

# --- OpenRouter AI ---
# Get a (free) key at https://openrouter.ai/keys
# If left empty, the app falls back to a local heuristic (no crash).
OPENROUTER_API_KEY=
# Optional. Leave EMPTY to auto-pick from every free model on OpenRouter (recommended).
# Set a model id, or a comma-separated preference list, to try those first.
OPENROUTER_MODEL=
