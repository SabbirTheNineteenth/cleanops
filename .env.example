# --- Database ---
DATABASE_URL=cleanops.db

# --- Auth ---
# Use a long random string in production (e.g. `openssl rand -base64 32`)
JWT_SECRET=change-me-to-a-long-random-secret-string

# --- OpenRouter AI ---
# Get a (free) key at https://openrouter.ai/keys
# If left empty, the app falls back to a local heuristic (no crash).
OPENROUTER_API_KEY=
# Free-tier friendly model. Swap for any model id from https://openrouter.ai/models
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
