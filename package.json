{
  "name": "cleanops",
  "version": "0.1.0",
  "private": true,
  "description": "CleanOps — Operations Incident Management System (Cleonix-inspired)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "node -e \"require('fs').rmSync('cleanops.db',{force:true})\" && npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "next": "^15.4.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "hono": "4.6.20",
    "drizzle-orm": "0.38.4",
    "better-sqlite3": "^12.2.0",
    "bcryptjs": "2.4.3",
    "jose": "5.9.6",
    "zod": "3.24.1",
    "recharts": "2.15.0",
    "clsx": "2.1.1",
    "lucide-react": "0.474.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.12",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "dotenv": "16.4.7",
    "drizzle-kit": "0.30.2",
    "tsx": "4.19.2",
    "tailwindcss": "3.4.17",
    "postcss": "8.5.1",
    "autoprefixer": "10.4.20",
    "typescript": "5.7.3"
  }
}
