{
  "name": "cleanops",
  "version": "0.1.0",
  "private": true,
  "description": "CleanOps — Operations Incident Management System (Cleonix-inspired)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "test:watch": "node --import tsx --test --watch \"tests/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "node -e \"require('fs').rmSync('cleanops.db',{force:true})\" && npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "@libsql/client": "0.14.0",
    "bcryptjs": "2.4.3",
    "clsx": "2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "jose": "5.9.6",
    "lucide-react": "0.474.0",
    "next": "^15.4.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "recharts": "2.15.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "dotenv": "16.4.7",
    "drizzle-kit": "0.30.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.25",
    "postcss": "8.5.1",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
